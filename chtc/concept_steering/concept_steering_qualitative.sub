OUT_TAG = best_thresholds
MIN_CUDA_GLOBAL_MEMORY_MB = 40000
PIP_TIMEOUT_SECONDS = 900
QUAL_TIMEOUT_SECONDS = 7200
MODEL_PATH = /staging/s/suresh27/models/llama31-8b-instruct
HF_CACHE = /staging/s/suresh27/hf_home

universe = container
container_image = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
docker_override_entrypoint = true
requirements = (TARGET.CUDAGlobalMemoryMb >= $(MIN_CUDA_GLOBAL_MEMORY_MB)) && (TARGET.HasChtcStaging =?= true)
rank = TARGET.CUDAGlobalMemoryMb

batch_name = coherence_concept_steering_qualitative_$(Cluster)
log = logs/concept_steering_qualitative_$(Cluster)_$(Process).log
output = logs/concept_steering_qualitative_$(Cluster)_$(Process).out
error = logs/concept_steering_qualitative_$(Cluster)_$(Process).err

executable = run_concept_qualitative.sh
arguments =
transfer_input_files = run_concept_qualitative.sh,src,vectors
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = concept_steering_qualitative_$(OUT_TAG)_results.tgz
stream_output = TRUE
stream_error = TRUE
environment = "MIN_CUDA_GLOBAL_MEMORY_MB=$(MIN_CUDA_GLOBAL_MEMORY_MB) PIP_TIMEOUT_SECONDS=$(PIP_TIMEOUT_SECONDS) QUAL_TIMEOUT_SECONDS=$(QUAL_TIMEOUT_SECONDS) MODEL_PATH=$(MODEL_PATH) HF_CACHE=$(HF_CACHE) OUT_TAG=$(OUT_TAG)"

request_gpus = 1
request_cpus = 8
request_memory = 64GB
request_disk = 80GB
+GPUJobLength = "short"
+is_resumable = true

queue 1
