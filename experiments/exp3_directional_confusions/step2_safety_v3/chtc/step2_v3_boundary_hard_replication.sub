universe = container
container_image = docker://vllm/vllm-openai:v0.6.6.post1
docker_override_entrypoint = true

batch_name = exp3_step2_v3_boundary_hard_replication_$(Cluster)
log = logs/$(Cluster)_$(Process).log
output = logs/$(Cluster)_$(Process).out
error = logs/$(Cluster)_$(Process).err

executable = run_step2_v3_boundary_hard_replication.sh
transfer_input_files = exp3_v3_bundle.tgz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = step2_v3_policy_routing_boundary_hard_replication_v1_outputs.tgz, step2_v3_policy_routing_boundary_hard_replication_v1_metadata.json

requirements = (Target.HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "short"
+is_resumable = true
request_gpus = 1
request_cpus = 2
request_memory = 24GB
request_disk = 40GB
gpus_minimum_capability = 8.0
gpus_minimum_memory = 24000M
require_gpus = (Capability >= 8.0 && Capability < 12.0 && GlobalMemoryMb >= 24000)

queue 1
